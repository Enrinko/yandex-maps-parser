# Root environment for docker-compose. Copy to .env and adjust as needed.
# (All values have sensible defaults baked into docker-compose.yml.)

# Host port the app is published on (http://localhost:8080).
APP_PORT=8080
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# Generate your own for production: `php artisan key:generate --show`.
# A dev key is baked into docker-compose.yml so the stack runs out of the box.
APP_KEY=

# Database
DB_DATABASE=yandex
DB_USERNAME=yandex
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Sanctum SPA cookie auth — hosts that receive a stateful session.
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost,localhost:5173,127.0.0.1
SESSION_DOMAIN=localhost
# Vite dev-server origin allowed for CORS during local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Scraper microservice
# Optional proxy to bypass Yandex captcha (datacenter IPs are almost always
# blocked). The browser routes through it; credentials may be embedded in the URL.
#
# Generic residential proxy (browser routes through it):
#   SCRAPER_PROXY=http://user:pass@host:port
SCRAPER_PROXY=
SCRAPER_TIMEOUT=240

# RECOMMENDED for Yandex captcha: Crawlbase Crawling API. When set, the scraper
# fetches fully rendered HTML (JS + scroll + anti-bot) via Crawlbase instead of
# driving a local browser. Use a JavaScript-enabled token.
CRAWLBASE_TOKEN=
