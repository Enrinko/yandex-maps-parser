# Root environment for docker-compose. Copy to .env and adjust as needed.
# (All values have sensible defaults baked into docker-compose.yml.)

# Host port the app is published on (http://localhost:8080).
APP_PORT=8080
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# Generate your own for production: `php artisan key:generate --show`.
# A dev key is baked into docker-compose.yml so the stack runs out of the box.
APP_KEY=

# Database
DB_DATABASE=yandex
DB_USERNAME=yandex
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Sanctum SPA cookie auth — hosts that receive a stateful session.
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost,localhost:5173,127.0.0.1
SESSION_DOMAIN=localhost
# Vite dev-server origin allowed for CORS during local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Scraper microservice
# Optional residential proxy to avoid datacenter-IP captchas:
# SCRAPER_PROXY=http://user:pass@host:port
SCRAPER_PROXY=
SCRAPER_TIMEOUT=240
